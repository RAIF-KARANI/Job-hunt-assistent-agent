{
  "id": "JobHuntAssist001",
  "name": "Job Hunt Assistant",
  "nodes": [
    {
      "id": "6d1f2a1e-0a01-4c1a-9a01-000000000001",
      "name": "Job URL form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [0, 0],
      "webhookId": "job-hunt",
      "parameters": {
        "formTitle": "Job Hunt Assistant",
        "formDescription": "Paste a job posting link. The agent reads it, compares it with your resumes, researches the company and drafts a cover note. This takes about 3 minutes, then the next page shows the draft for your approval.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Job posting URL",
              "placeholder": "https://...",
              "requiredField": true
            }
          ]
        },
        "options": {
          "buttonLabel": "Analyze"
        }
      }
    },
    {
      "id": "6d1f2a1e-0a01-4c1a-9a01-000000000002",
      "name": "Start agent run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/runs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{ $env.AGENT_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $json['Job posting URL'], callback_url: $execution.resumeUrl }) }}",
        "options": {}
      }
    },
    {
      "id": "6d1f2a1e-0a01-4c1a-9a01-000000000003",
      "name": "Wait for the agent",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [440, 0],
      "webhookId": "6d1f2a1e-0a01-4c1a-9a01-0000000000a3",
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "limitWaitTime": true,
        "limitType": "afterTimeInterval",
        "resumeAmount": 20,
        "resumeUnit": "minutes",
        "options": {}
      }
    },
    {
      "id": "6d1f2a1e-0a01-4c1a-9a01-000000000004",
      "name": "Draft ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "6d1f2a1e-0a01-4c1a-9a01-0000000000c1",
              "leftValue": "={{ $json.body?.status }}",
              "rightValue": "awaiting_approval",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "6d1f2a1e-0a01-4c1a-9a01-000000000005",
      "name": "Review the draft",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.3,
      "position": [880, -100],
      "webhookId": "6d1f2a1e-0a01-4c1a-9a01-0000000000a5",
      "parameters": {
        "operation": "page",
        "formFields": {
          "values": [
            {
              "fieldType": "html",
              "html": "={{ '<p><b>Fit score: ' + $json.body.fit_score + '/100</b> with ' + $json.body.resume + '<br>' + $json.body.score_breakdown + '</p>' + ($json.body.warnings.length ? '<p><b>Check these numbers:</b> ' + $json.body.warnings.join(', ') + '</p>' : '') + '<hr><p>' + $json.body.draft.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').split(String.fromCharCode(10)).join('<br>') + '</p><hr>' }}"
            },
            {
              "fieldLabel": "Decision",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  { "option": "Approve and save" },
                  { "option": "Reject" }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "options": {
          "formTitle": "={{ $json.body.job.title + ' @ ' + $json.body.job.company }}",
          "formDescription": "The agent is paused, waiting for your decision. Nothing is saved unless you approve.",
          "buttonLabel": "Send decision"
        }
      }
    },
    {
      "id": "6d1f2a1e-0a01-4c1a-9a01-000000000006",
      "name": "Send decision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, -100],
      "parameters": {
        "method": "POST",
        "url": "={{ 'http://host.docker.internal:8000/runs/' + $('Wait for the agent').item.json.body.thread_id + '/decision' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-API-Key", "value": "={{ $env.AGENT_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ decision: $json.Decision === 'Approve and save' ? 'approve' : 'reject' }) }}",
        "options": {}
      }
    },
    {
      "id": "6d1f2a1e-0a01-4c1a-9a01-000000000007",
      "name": "Show result",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.3,
      "position": [1320, -100],
      "webhookId": "6d1f2a1e-0a01-4c1a-9a01-0000000000a7",
      "parameters": {
        "operation": "completion",
        "respondWith": "text",
        "completionTitle": "={{ $json.approved ? 'Saved ✅' : 'Rejected' }}",
        "completionMessage": "={{ $json.approved ? 'Your cover note was saved to the tracker (' + $json.saved_path + '). Status: cover_note_ready.' : 'Nothing was saved. The job is still in your tracker.' }}",
        "options": {}
      }
    },
    {
      "id": "6d1f2a1e-0a01-4c1a-9a01-000000000008",
      "name": "Show problem",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.3,
      "position": [880, 120],
      "webhookId": "6d1f2a1e-0a01-4c1a-9a01-0000000000a8",
      "parameters": {
        "operation": "completion",
        "respondWith": "text",
        "completionTitle": "The agent couldn't produce a draft",
        "completionMessage": "={{ 'Status: ' + ($json.body?.status ?? 'timed out (no answer within 20 minutes)') + '. ' + ($json.body?.error ?? $json.body?.reason ?? '') + ' If the page needs a login, use the web UI (streamlit run app.py) and paste the text there.' }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Job URL form": { "main": [[{ "node": "Start agent run", "type": "main", "index": 0 }]] },
    "Start agent run": { "main": [[{ "node": "Wait for the agent", "type": "main", "index": 0 }]] },
    "Wait for the agent": { "main": [[{ "node": "Draft ready?", "type": "main", "index": 0 }]] },
    "Draft ready?": {
      "main": [
        [{ "node": "Review the draft", "type": "main", "index": 0 }],
        [{ "node": "Show problem", "type": "main", "index": 0 }]
      ]
    },
    "Review the draft": { "main": [[{ "node": "Send decision", "type": "main", "index": 0 }]] },
    "Send decision": { "main": [[{ "node": "Show result", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "pinData": {}
}
