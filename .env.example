# Copy this file to `.env` and edit the values.
# `.env` is git-ignored, so your keys stay on your machine.

# ---- Which LLM to use ----
# Options: ollama | anthropic | openai | google
LLM_PROVIDER=ollama

# Model name for the chosen provider. Examples:
#   ollama:    qwen3:8b   (fast)   | qwen3:14b (smarter, slower) | llama3.2
#   anthropic: claude-sonnet-5-5
#   openai:    gpt-4o-mini
#   google:    gemini-2.0-flash
LLM_MODEL=qwen3:8b

# 0 = deterministic/focused, 1 = more creative.
LLM_TEMPERATURE=0.2

# ---- Ollama only ----
OLLAMA_BASE_URL=http://localhost:11434
# qwen3 can "think" before answering. false = faster, cleaner answers.
OLLAMA_REASONING=false
# Context window in tokens = how much text the model can "see" at once.
# Ollama's default is small; job pages + resumes need more. Higher = more RAM.
OLLAMA_NUM_CTX=16384

# ---- API keys (only needed for cloud providers) ----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# ---- Quality ----
# true = a second LLM call checks each skill match really is proven by its
# resume quote (LLM-as-judge). More accurate, ~15-30 s slower per resume.
JUDGE_EVIDENCE=true

# ---- Tracing (Phase 8c) ----
# off | langfuse | langsmith
#   langfuse  = self-hosted on this PC (infra/langfuse), traces stay private
#   langsmith = LangChain's cloud; traces (incl. your resume text) are uploaded
TRACING=off

# Langfuse: keys are generated in infra/langfuse/.env
# (LANGFUSE_INIT_PROJECT_PUBLIC_KEY / ..._SECRET_KEY)
LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# LangSmith: create a key at https://smith.langchain.com (Settings -> API Keys)
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=job-hunt-assistant