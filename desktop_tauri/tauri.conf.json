  "productName": "JobLens",
  "version": "2.0.0",
  "identifier": "com.joblens.desktop",
  "build": {
    "frontendDist": "../desktop_web/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
